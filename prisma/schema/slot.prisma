model Slot {
  id        String   @id @default(cuid())
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    SlotStatus @default(AVAILABLE)
  booking   Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([gameId, startTime])
  @@map("slots")
}